{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": {
      "@/components/ui/*": ["../src/components/ui/*"],
      "@/hooks/useCopyFeedback": ["../src/hooks/useCopyFeedback.ts"],
      "@/lib/utils": ["../src/lib/utils.ts"],
      "@/lib/pubky-ring": ["../src/lib/pubky-ring.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "config-from-env.mjs"]
}
